# 服务端口
PORT=8787
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_PRIVATE_PROVIDER_BASE_URLS=false
PUBLIC_BASE_URL=
SHARE_STORAGE_DIR=.data/shares
SHARE_TTL_DAYS=7
MAX_SHARE_BYTES=2097152
DATA_STORAGE_DRIVER=file
DATA_STORAGE_FILE=.data/siteforge.json
MYSQL_URL=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL_MODE=disabled
MYSQL_CONNECT_TIMEOUT_MS=10000
AUTH_JWT_SECRET=siteforge-development-secret-change-before-production-2026
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MIN=10
ADMIN_EMAILS=admin@example.com
SYSTEM_EVENT_LIMIT=5000
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
MONTHLY_GENERATION_LIMIT=100
MAX_PROJECT_BYTES=2097152
PUBLISH_STORAGE_DIR=.data/published
PUBLISH_BASE_DOMAIN=siteforge.local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
CDN_INVALIDATION_WEBHOOK_URL=
CDN_INVALIDATION_WEBHOOK_TOKEN=

# 分布式验证码申请／校验限制:redis / memory
AUTH_DISTRIBUTED_LIMIT_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_RATE_LIMIT_HASH_KEY=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_FAIL_MODE=memory
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=900
AUTH_MAX_CODE_REQUESTS=5
AUTH_MAX_VERIFY_FAILURES=5
AUTH_REDIS_TIMEOUT_MS=1500

# 隔离 Runner:disabled / docker / local-process;生产环境只推荐 docker
RUNNER_DRIVER=disabled
RUNNER_TIMEOUT_SECONDS=300
RUNNER_MEMORY_MB=1024
RUNNER_CPUS=1
RUNNER_PIDS_LIMIT=256
RUNNER_MAX_OUTPUT_BYTES=1000000
RUNNER_MAX_CONCURRENT=2
RUNNER_IMAGE_PREFIX=siteforge/runner
RUNNER_IMAGE_LOCK_FILE=infra/runner/images.lock.json

# 不可变在线预览;生产环境应使用不携带主站 Cookie 的独立域名
PREVIEW_TTL_SECONDS=86400
PREVIEW_PUBLIC_BASE_URL=

# CI/Runner 导入可信发布门禁时使用,生产环境至少 32 字节随机 Secret
RELEASE_GATE_TOKEN=replace-with-at-least-32-random-characters

# disabled / webhook
DEPLOYMENT_DRIVER=disabled
DEPLOYMENT_WEBHOOK_URL=
DEPLOYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

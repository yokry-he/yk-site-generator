# 服务端口
PORT=8787

# 运行环境:development / test / production
NODE_ENV=development

# 允许的前端来源(逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 自定义模型 Base URL 默认禁止访问本机/内网;仅本地模型开发时显式开启
ALLOW_PRIVATE_PROVIDER_BASE_URLS=false

# 服务端对外访问根地址,用于分享与发布绝对链接;本地可留空
PUBLIC_BASE_URL=

# 临时分享存储目录(生产环境请挂载持久卷)
SHARE_STORAGE_DIR=.data/shares
SHARE_TTL_DAYS=7
MAX_SHARE_BYTES=2097152

# 数据存储:file 适合本地/单实例,mysql 适合正式多实例
DATA_STORAGE_DRIVER=file
DATA_STORAGE_FILE=.data/siteforge.json
# 示例:mysql://siteforge:password@127.0.0.1:3306/siteforge
MYSQL_URL=
MYSQL_CONNECTION_LIMIT=10
# disabled / preferred(加密但不校验证书) / required(校验证书)
MYSQL_SSL_MODE=disabled
MYSQL_CONNECT_TIMEOUT_MS=10000

# 生产环境必须换成随机生成、至少 32 字符的独立密钥
AUTH_JWT_SECRET=siteforge-development-secret-change-before-production-2026
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MIN=10

# 首次登录时自动授予管理员权限的邮箱,多个邮箱用逗号分隔
ADMIN_EMAILS=admin@example.com
# 单实例诊断事件最多保留条数
SYSTEM_EVENT_LIMIT=5000

# 邮件发送 Webhook;开发环境留空时接口会返回 debugCode
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# 每个账号每月生成/迭代总额度
MONTHLY_GENERATION_LIMIT=100

# 云端项目单版本大小上限
MAX_PROJECT_BYTES=2097152

# 本地发布适配器与展示域名提示
PUBLISH_STORAGE_DIR=.data/published
PUBLISH_BASE_DOMAIN=siteforge.local

# S3 兼容对象存储:四项全部配置后自动替代本地发布目录
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 例如 CDN / R2 Public Bucket 的公开根地址
S3_PUBLIC_BASE_URL=

# 可选 CDN 缓存失效 Webhook
CDN_INVALIDATION_WEBHOOK_URL=
CDN_INVALIDATION_WEBHOOK_TOKEN=

# 服务端口
PORT=8787

# 运行环境:development / test / production
NODE_ENV=development

# 允许的前端来源(逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 临时分享存储目录(生产环境请挂载持久卷)
SHARE_STORAGE_DIR=.data/shares

# 临时分享有效期,MVP 最大 7 天
SHARE_TTL_DAYS=7

# 单个分享产物最大字节数(默认 2MB)
MAX_SHARE_BYTES=2097152

# 服务端对外访问根地址,用于生成绝对分享链接;本地可留空
PUBLIC_BASE_URL=

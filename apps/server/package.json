{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-generate.ts",
    "typecheck": "tsc --noEmit",
    "db:mysql:check": "tsx scripts/check-mysql.ts",
    "db:mysql:import": "tsx scripts/migrate-json-to-mysql.ts",
    "db:mysql:export": "tsx scripts/export-mysql-snapshot.ts",
    "db:mysql:ci": "tsx scripts/mysql-ci.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.2",
    "mysql2": "^3.23.1",
    "prompts": "workspace:*",
    "shared": "workspace:*",
    "zod": "^4.3.5",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

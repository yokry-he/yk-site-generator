{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e-generate.ts",
    "e2e:iterate": "tsx scripts/e2e-iterate.ts",
    "e2e:history": "tsx scripts/e2e-history.ts",
    "e2e:browser": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "shared": "workspace:*",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.5"
  }
}

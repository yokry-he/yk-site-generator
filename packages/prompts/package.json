{
  "name": "prompts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval-prompts.ts",
    "eval:quality": "tsx scripts/eval-quality.ts",
    "eval:annotate": "tsx scripts/annotate-quality-report.ts",
    "eval:trend": "tsx scripts/summarize-quality-reports.ts"
  },
  "dependencies": {
    "shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

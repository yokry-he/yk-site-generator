{
  "name": "yk-site-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "docs:check": "node scripts/check-bilingual-docs.mjs",
    "rc:audit": "pnpm --filter web exec tsx ../../scripts/check-manual-scaffold-integrity.ts",
    "rc:golden": "pnpm --filter web exec tsx ../../scripts/generate-golden-projects.ts --check",
    "rc:golden:update": "pnpm --filter web exec tsx ../../scripts/generate-golden-projects.ts --write"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}

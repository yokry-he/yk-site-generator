{
  "name": "yk-site-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "docs:check": "node scripts/check-bilingual-docs.mjs",
    "rc:preflight": "node --test scripts/rc-preflight.test.mjs && node scripts/rc-preflight.mjs --profile=core",
    "rc:preflight:full": "node --test scripts/rc-preflight.test.mjs && node scripts/rc-preflight.mjs --profile=full",
    "rc:preflight:release": "node --test scripts/rc-preflight.test.mjs && node scripts/rc-preflight.mjs --profile=release",
    "rc:deps": "node --test scripts/rc-dependencies.test.mjs && node scripts/install-rc-dependencies.mjs --mode=all",
    "rc:deps:fetch": "node --test scripts/rc-dependencies.test.mjs && node scripts/install-rc-dependencies.mjs --mode=fetch",
    "rc:deps:install": "node --test scripts/rc-dependencies.test.mjs && node scripts/install-rc-dependencies.mjs --mode=install",
    "rc:deps:plan": "node scripts/install-rc-dependencies.mjs --mode=all --plan",
    "rc:workflow-bootstrap": "node --test scripts/rc-workflow-bootstrap.test.mjs && node scripts/check-rc-workflow-bootstrap.mjs",
    "rc:triage:test": "node --test scripts/rc-triage.test.mjs",
    "rc:triage": "node --test scripts/rc-triage.test.mjs && node scripts/rc-triage.mjs --allow-missing --fail-on=never",
    "rc:triage:strict": "node --test scripts/rc-triage.test.mjs && node scripts/rc-triage.mjs --allow-missing --fail-on=blocking",
    "rc:triage:plan": "node scripts/rc-triage.mjs --allow-missing --fail-on=never --plan",
    "rc:workstation:validate": "node --test scripts/rc-workstation.test.mjs && node scripts/validate-rc-workstation.mjs",
    "rc:workstation:plan": "node scripts/rc-workstation.mjs --command=plan",
    "rc:workstation:build": "node scripts/rc-workstation.mjs --run=build",
    "rc:workstation:up": "node scripts/rc-workstation.mjs --run=up",
    "rc:workstation:core": "node scripts/rc-workstation.mjs --run=core",
    "rc:workstation:full": "node scripts/rc-workstation.mjs --run=full",
    "rc:workstation:shell": "node scripts/rc-workstation.mjs --run=shell",
    "rc:workstation:down": "node scripts/rc-workstation.mjs --run=down",
    "rc:audit": "pnpm --filter web exec tsx ../../scripts/check-manual-scaffold-integrity.ts",
    "rc:security": "pnpm --filter web exec tsx ../../scripts/security-audit.ts",
    "rc:golden": "pnpm --filter web exec tsx ../../scripts/generate-golden-projects.ts --check",
    "rc:golden:update": "pnpm --filter web exec tsx ../../scripts/generate-golden-projects.ts --write",
    "rc:matrix:plan": "pnpm --filter web exec tsx ../../scripts/run-golden-matrix.ts --plan",
    "rc:matrix": "pnpm --filter web exec tsx ../../scripts/run-golden-matrix.ts --execute",
    "rc:redis": "pnpm --filter web exec tsx ../../scripts/redis-multi-instance-smoke.ts",
    "rc:evidence": "pnpm --filter web exec tsx ../../scripts/write-rc-evidence.ts",
    "rc:prepare": "pnpm --filter web exec tsx ../../scripts/prepare-rc-release.ts",
    "rc:gates": "pnpm --filter web exec tsx ../../scripts/run-rc-gates.ts",
    "rc:gates:core": "pnpm --filter web exec tsx ../../scripts/run-rc-gates.ts --profile=core",
    "rc:gates:full": "pnpm --filter web exec tsx ../../scripts/run-rc-gates.ts --profile=full",
    "rc:gates:plan": "pnpm --filter web exec tsx ../../scripts/run-rc-gates.ts --profile=core --plan",
    "runner:images:validate": "pnpm --filter web exec tsx ../../scripts/validate-runner-images.ts",
    "runner:cleanup": "pnpm --filter web exec tsx ../../scripts/cleanup-runner-containers.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11 <12"
  }
}
